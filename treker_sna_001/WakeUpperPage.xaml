<Page x:Class="treker_sna_001.WakeUpperPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:treker_sna_001"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="WakeUpperPage"
      Style="{DynamicResource pageStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="320"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Cursor="">
                <TextBlock Text="Установить напоминание для: "/>
                <ComboBox Name="napomainanie" Width="100" Style="{StaticResource ComboBoxStyle}"/>
                <TextBlock Text=" в "/>
                <ComboBox x:Name="HourComboBox" Width="50" Style="{StaticResource ComboBoxStyle}"/>
                <ComboBox x:Name="MinuteComboBox" Width="50" Style="{StaticResource ComboBoxStyle}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Установить" Name="Set" Click="Set_Click"/>
                <Button Content="Удалить" Name="Del" Click="Del_Click"/>
            </StackPanel>
        </StackPanel>
            <DataGrid Name="WakeUpperDataGrid" Style="{StaticResource DataGridStyle}" Width="460" Grid.Row="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Пользователь" Binding="{Binding idUser.userLogin}" Foreground="DarkGray" Width="150"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding FormatDate}" Foreground="DarkGray" Width="75"/>
                    <DataGridTextColumn Header="Время" Binding="{Binding FormatTime}" Foreground="DarkGray" Width="75"/>
                    <DataGridTextColumn Header="Причина" Binding="{Binding FormatOcassion}" Foreground="DarkGray" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
    </Grid>
</Page>
