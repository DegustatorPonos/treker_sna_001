<Page x:Class="treker_sna_001.journalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:treker_sna_001"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="journalPage"
      Style="{DynamicResource pageStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="320"/>
        </Grid.RowDefinitions>
        
        <StackPanel Orientation="Horizontal">
            <Button Content="Добавить запись" Name="addnote" Click="addnote_Click"/>
            <Button Content="Удалить запись" Name="delnote" Click="delnote_Click"/>
            <Button Content="Очистить журнал" Name="clear" Click="clear_Click"/>
        </StackPanel>

        <DataGrid Name="JournalDataGrid" Width="800" Style="{StaticResource DataGridStyle}" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Width="100" Header="Тип сна" Binding="{Binding TypeDream}" HeaderStyle="{Binding HeaderStyle}" Foreground="DarkGray"/>
                <DataGridTextColumn Width="90" Header="Ощущения" Binding="{Binding Feelings}" HeaderStyle="{Binding HeaderStyle}" Foreground="DarkGray"/>
                <DataGridTextColumn Width="100" Header="Пробуждения" Binding="{Binding WakeUpCount}" Foreground="DarkGray"/>
                <DataGridTextColumn Width="125" Header="Время отбоя" Binding="{Binding formatStartDate}" Foreground="DarkGray"/>
                <DataGridTextColumn Width="125" Header="Время подъема" Binding="{Binding formatEndtDate}" Foreground="DarkGray"/>
                <DataGridTextColumn Width="70" Header="Стресс" Binding="{Binding Stress}" Foreground="DarkGray"/>
                <DataGridTextColumn Width="70" Header="Усталость" Binding="{Binding Phisical}" Foreground="DarkGray"/>
                <DataGridTextColumn Width="90" Header="Температура" Binding="{Binding Temperature}" Foreground="DarkGray"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
